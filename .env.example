# Puerto donde se sirve la web del calendario y la API
PORT=3000

# JID del grupo de WhatsApp autorizado a cargar eventos (formato: XXXXXXXXXX-XXXXXXXXXX@g.us)
# Dejalo vacio la primera vez: el bot va a imprimir en consola el JID de cada grupo
# donde reciba un mensaje, para que lo copies aca.
GROUP_ID=

# Huso horario que se asume para las fechas escritas en /evento (Argentina = -03:00).
# Cambialo solo si la familia vive en otro huso horario.
UTC_OFFSET=-03:00

# API key gratuita de Google Gemini (para interpretar el texto libre de /evento).
# Se consigue en https://aistudio.google.com/apikey
GEMINI_API_KEY=
